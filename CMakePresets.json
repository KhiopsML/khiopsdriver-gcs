{
  "version": 3,
  "configurePresets": [
    {
      "name": "configure-ninja-dbg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "configure-ninja-rel",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "build-ninja-dbg",
      "configurePreset": "configure-ninja-dbg"
    },
    {
      "name": "build-ninja-rel",
      "configurePreset": "configure-ninja-rel"
    }
  ],
  "testPresets": [
    {
      "name": "test-ninja-dbg",
      "configurePreset": "configure-ninja-dbg",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-ninja-rel",
      "configurePreset": "configure-ninja-rel",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
